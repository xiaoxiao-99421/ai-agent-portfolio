# ===== LLM（OpenAI 兼容接口，如 DeepSeek / 通义 / 本地 Ollama）=====
# 生成回答用
LLM_API_KEY=sk-xxxx
LLM_API_URL=https://api.your-provider.com/v1
LLM_MODEL=your-chat-model

# ===== Embedding 模型（本地路径或 HuggingFace 名）=====
# 模型已复制到本项目内 models/bge-m3（自包含，无需联网，rag-minimal 那份可保留）。
# 该模型即 BAAI/bge-m3（1024 维，xlm-roberta，dense/colbert/sparse 多头），与 rag-minimal 原模型完全一致。
# ⚠️ 它并非 bge-small-zh-v1.5（那是 512 维），请勿混用其他维度模型，否则向量库维度不匹配报错。
# 如改用其他本地模型，改成其绝对路径即可。
# 注意：rag-core 用 local_files_only=True 加载，不要填 HuggingFace 名（如 BAAI/bge-m3），
#       否则会因拒绝联网下载而报错；且不同模型维度不同，混用会导致向量库不匹配。
EMBEDDING_MODEL_PATH=models/bge-m3

# ===== 检索参数 =====
TOP_K=5

# ===== 健壮性（超时 / 重试 / 可观测）=====
# 单次 LLM 调用超时（秒）
LLM_TIMEOUT_SECONDS=30
# LLM 调用最大重试次数（指数退避，封顶 8s）
LLM_MAX_RETRIES=3
# 工具调用超时（秒），超时即降级不阻塞
TOOL_TIMEOUT_SECONDS=15
# 是否打印 trace_id 结构化日志（便于串联排查）
TRACE_ENABLED=true

# ===== 评测开关 =====
# 是否启用 LLM 自动判相关（关掉则只用规则/科室命中）
EVAL_USE_LLM=true
# 人工复核抽样比例（其余由 LLM 自动判定）
HUMAN_REVIEW_RATIO=0.1
